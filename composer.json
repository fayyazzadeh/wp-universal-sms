{
  "name": "fayyazzadeh/wp-universal-sms",
  "description": "Provider-agnostic SMS gateway for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Fayyazdeh\\UniversalSms\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fayyazdeh\\UniversalSms\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "php -l wp-universal-sms.php"
  }
}
